{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "autoupdate": true,
  "small_model": "opencode-go-mmx/minimax-m2.5",
  "plugin": ["@ex-machina/opencode-anthropic-auth"],
  "permission": {
    "websearch": "allow",
    "bash": {
      "* /tmp/*": "allow",
      "* /private/tmp/*": "allow",
      "gh pr merge *": "ask",
      "gh pr merge": "ask",
      "git push --force *": "ask",
      "git push -f *": "ask",
      "git push --force-with-lease *": "ask",
      "git reset --hard *": "ask",
      "git branch -D *": "ask",
      "git clean -f *": "ask",
      "git rebase *": "ask",
      "git checkout -- *": "ask",
      "gh pr close *": "ask",
      "gh repo delete *": "deny",
      "find*-delete *": "ask",
      "find*--delete *": "ask",
      "rm *": "ask",
      "rm -rf *": "ask",
      "rm -r *": "ask",
      "rm -f *": "ask",
      "rmdir *": "ask",
      "but setup": "allow",
      "but teardown": "ask",
      "but status *": "allow",
      "but status": "allow",
      "but diff *": "allow",
      "but diff": "allow",
      "but show *": "allow",
      "but branch *": "allow",
      "but branch": "allow",
      "but commit *": "allow",
      "but rub *": "allow",
      "but stage *": "allow",
      "but absorb *": "allow",
      "but absorb": "allow",
      "but mark *": "allow",
      "but unmark *": "allow",
      "but unmark": "allow",
      "but push *": "allow",
      "but push": "allow",
      "but pull *": "allow",
      "but pull": "allow",
      "but pr *": "allow",
      "but squash *": "allow",
      "but oplog": "allow",
      "but oplog snapshot *": "allow",
      "but undo": "ask",
      "but oplog restore *": "ask",
      "but resolve *": "ask"
    }
  },
  "instructions": ["AGENTS.md", "CLAUDE.md", ".cursor/rules/*.md"],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--output-dir",
        ".screenshots"
      ],
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "provider": {
    "google": {
      "models": {
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gemini-3-pro-preview": {
          "name": "Gemini 3 Pro Preview (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gemini-3.1-pro-preview-customtools": {
          "name": "Gemini 3.1 Pro Preview Custom Tools (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "deepseek-v4-pro:cloud": {
          "name": "DeepSeek V4 Pro (Ollama Cloud)",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "deepseek-v4-flash:cloud": {
          "name": "DeepSeek V4 Flash (Ollama Cloud)",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "glm-5.1:cloud": {
          "name": "GLM 5.1 (Ollama Cloud)",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "kimi-k2.6:cloud": {
          "name": "Kimi K2.6 (Ollama Cloud)",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    },
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1"
      },
      "models": {
        "glm-5.1": {
          "name": "GLM 5.1 (Go)",
          "limit": {
            "context": 202752,
            "output": 65536
          }
        },
        "qwen3.6-plus": {
          "name": "Qwen 3.6 Plus (Go)",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        }
      }
    },
    "opencode-go-mmx": {
      "npm": "@ai-sdk/anthropic",
      "name": "OpenCode Go (MiniMax)",
      "options": {
        "baseURL": "https://opencode.ai/zen/go"
      },
      "models": {
        "minimax-m2.5": {
          "name": "MiniMax M2.5 (Go)",
          "limit": {
            "context": 202752,
            "output": 65536
          }
        }
      }
    }
  }
}
